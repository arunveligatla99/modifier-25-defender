# Modifier 25 Defender UI image.
# Node 20 base, runs Vite dev server. Production build is deferred.

FROM node:20-alpine

WORKDIR /srv/ui

COPY ui/package.json /srv/ui/package.json
COPY ui/package-lock.json* /srv/ui/

RUN npm install

# Source bind-mounted by docker-compose for hot reload.
EXPOSE 5173

CMD ["npm", "run", "dev", "--", "--host", "0.0.0.0", "--port", "5173"]
