# Modifier 25 Defender, local development environment template.
# Copy to .env and fill in OPENAI_API_KEY before running `make eval` or `make dev`.
# .env is gitignored; never commit a real key.

# ----- LLM provider -----
# Required. Used by the synthesis agents and the dense embedder.
OPENAI_API_KEY=

# ----- Qdrant -----
# Default points at the docker-compose service. Override for a remote Qdrant.
QDRANT_URL=http://localhost:6333

# ----- Postgres (LangGraph checkpoints + Langfuse backend) -----
POSTGRES_USER=m25d
POSTGRES_PASSWORD=m25d_dev_password
POSTGRES_DB=m25d
POSTGRES_DSN=postgresql://m25d:m25d_dev_password@localhost:5432/m25d

# ----- Langfuse -----
LANGFUSE_HOST=http://localhost:3000
LANGFUSE_PUBLIC_KEY=pk-lf-local
LANGFUSE_SECRET_KEY=sk-lf-local
LANGFUSE_NEXTAUTH_SECRET=replace_with_a_random_secret_in_dev
LANGFUSE_SALT=replace_with_a_random_salt_in_dev
LANGFUSE_INIT_USER_EMAIL=dev@local
LANGFUSE_INIT_USER_PASSWORD=dev_local_password

# ----- Synthesis defaults -----
LLM_MODEL=gpt-4o
LLM_TEMPERATURE=0.0
EMBEDDING_MODEL=text-embedding-3-large

# ----- NLI verifier (Compliance Guard) -----
NLI_MODEL=MoritzLaurer/DeBERTa-v3-large-mnli-fever-anli-ling-wanli
NLI_THRESHOLD=0.75

# ----- Cache -----
LLM_CACHE_DIR=eval/.cache

# ----- App settings -----
LOG_LEVEL=INFO
SYNTHETIC_DATA_SEED=42
